{
  "name": "@layzee/lz-stryker-ui-mutators",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS mutation operators for JSX that Playwright tests can kill",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0",
    "playwright-core": ">=1.63.0 <2"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@stryker-mutator/api": "10.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "playwright-core": "1.64.1"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "generate-roles": {
        "command": "node scripts/generate-roles.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/**/*",
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/bundled-roles.ts",
          {
            "env": "LZ_UI_MUTATORS_ROLES_FROM"
          },
          {
            "env": "LZ_UI_MUTATORS_ROLES_OUT"
          },
          {
            "externalDependencies": [
              "playwright-core"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/bundled-roles.ts"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "generate-roles"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck",
          "generate-roles"
        ]
      },
      "lint": {
        "dependsOn": [
          "generate-roles"
        ]
      },
      "test": {
        "dependsOn": [
          "generate-roles"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test test/*.test.ts"
  }
}
