{
  "name": "@layzee/lz-stryker-ui-mutators",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS mutators for JSX that Playwright tests can kill",
  "keywords": [
    "stryker",
    "playwright",
    "mutation testing",
    "jsx",
    "accessibility"
  ],
  "homepage": "https://github.com/LayZeeDK/lz-playwright-test/tree/main/packages/lz-stryker-ui-mutators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/lz-playwright-test.git",
    "directory": "packages/lz-stryker-ui-mutators"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0",
    "playwright-core": ">=1.63.0 <2"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@stryker-mutator/api": "10.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "playwright-core": "1.64.1"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "generate-roles": {
        "command": "node scripts/generate-roles.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/generate-roles.ts",
          "{projectRoot}/scripts/roles-generator.ts",
          "{projectRoot}/src/playwright-roles.ts",
          "{projectRoot}/src/span-swap.ts",
          "{projectRoot}/src/is-record.ts",
          {
            "externalDependencies": [
              "playwright-core"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/bundled-roles.ts"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "generate-roles"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck",
          "generate-roles"
        ]
      },
      "lint": {
        "dependsOn": [
          "generate-roles"
        ],
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "test": {
        "dependsOn": [
          "generate-roles"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test test/*.test.ts"
  }
}
