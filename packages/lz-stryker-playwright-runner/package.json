{
  "name": "@layzee/lz-stryker-playwright-runner",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS test runner plugin for Playwright Test (e2e and component tests)",
  "keywords": [
    "stryker",
    "playwright",
    "mutation testing",
    "@stryker-mutator/test-runner-plugin"
  ],
  "homepage": "https://github.com/LayZeeDK/lz-playwright-test/tree/main/packages/lz-stryker-playwright-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/lz-playwright-test.git",
    "directory": "packages/lz-stryker-playwright-runner"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/worker-hook.js"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.63.0 <2",
    "@stryker-mutator/core": "^10.0.0"
  },
  "dependencies": {
    "@stryker-mutator/api": "10.1.1"
  },
  "devDependencies": {
    "@layzee/lz-stryker-ui-mutators": "*",
    "ajv": "8.20.0"
  },
  "initStrykerConfig": {
    "appendPlugins": [
      "@layzee/lz-stryker-playwright-runner"
    ],
    "testRunner": "lz-stryker-playwright",
    "testRunner_comment": "Take a look at https://github.com/LayZeeDK/lz-playwright-test/tree/main/packages/lz-stryker-playwright-runner#readme for information about the lz-stryker-playwright plugin.",
    "lzStrykerPlaywright": {
      "configFile": "playwright.config.ts"
    },
    "coverageAnalysis": "perTest",
    "concurrency": 1,
    "timeoutMS": 11000
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "lint": {
        "dependsOn": [
          "@layzee/lz-stryker-ui-mutators:generate-roles"
        ],
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "test-browser": {
        "dependsOn": [
          "@layzee/lz-stryker-ui-mutators:generate-roles"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test \"test/*.test.ts\"",
    "test-browser": "node --conditions=@layzee/source --test \"test/browser/*.test.ts\""
  }
}
