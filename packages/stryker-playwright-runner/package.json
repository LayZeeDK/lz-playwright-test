{
  "name": "@layzee/stryker-playwright-runner",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS test runner plugin for Playwright Test (e2e and component tests)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/worker-hook.js"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.63.0",
    "@stryker-mutator/core": "^10.0.0"
  },
  "dependencies": {
    "@stryker-mutator/api": "10.1.1"
  },
  "devDependencies": {
    "@layzee/stryker-ui-mutators": "*"
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test test/runner.test.ts test/run-result.test.ts test/ui-mutators.test.ts"
  }
}
