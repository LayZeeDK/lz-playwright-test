{
  "name": "@layzee/stryker-playwright-mutators",
  "version": "0.0.0",
  "private": true,
  "description": "StrykerJS mutators for Playwright test code that Playwright tests of the app can kill",
  "keywords": [
    "stryker",
    "playwright",
    "mutation testing",
    "mutators",
    "test code"
  ],
  "homepage": "https://github.com/LayZeeDK/lz-playwright-test/tree/main/packages/stryker-playwright-mutators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/lz-playwright-test.git",
    "directory": "packages/stryker-playwright-mutators"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/core": "~10.1.0"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build",
          "^typecheck"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "...",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      }
    }
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test test/*.test.ts"
  }
}
