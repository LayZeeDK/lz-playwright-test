{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/fixtures/*/.storybook/*.ts",
    "test/fixtures/reporter/*.json"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
