      "source": "// SpyStub spike: reset off for the file, so the definition-time stub reaches the component and the play checks it.\nimport type { Meta, StoryObj } from '@storybook/react-vite';\nimport { expect, fn } from 'storybook/test';\n\nfunction Probe({ getValue }: { getValue: () => unknown }) {\n  return <output data-testid=\"value\">{String(getValue())}</output>;\n}\n\nconst meta = {\n  component: Probe,\n  parameters: { test: { restoreMocks: false } },\n} satisfies Meta<typeof Probe>;\nexport default meta;\ntype Story = StoryObj<typeof meta>;\n\nexport const CheckedStub: Story = {\n  args: { getValue: fn().mockReturnValue('stubbed') },\n  play: async ({ canvas }) => {\n    await expect(canvas.getByTestId('value')).toHaveTextContent('stubbed');\n  },\n};\n\nexport const UncheckedStub: Story = {\n  args: { getValue: fn().mockReturnValue('stubbed') },\n  play: async ({ canvas }) => {\n    await expect(canvas.getByTestId('value')).toBeInTheDocument();\n  },\n};\n"
    },
