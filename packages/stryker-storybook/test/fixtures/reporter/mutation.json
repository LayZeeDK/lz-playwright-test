      "source": "// SpyStub spike: default reset, so the definition-time stub is erased before render; the play only checks the\n// output exists, like a story that passes on the unstubbed branch.\nimport type { Meta, StoryObj } from '@storybook/react-vite';\nimport { expect, fn } from 'storybook/test';\n\nfunction Probe({ getValue }: { getValue: () => unknown }) {\n  return <output data-testid=\"value\">{String(getValue())}</output>;\n}\n\nconst meta = { component: Probe } satisfies Meta<typeof Probe>;\nexport default meta;\ntype Story = StoryObj<typeof meta>;\n\nexport const ErasedStub: Story = {\n  args: { getValue: fn().mockReturnValue('stubbed') },\n  play: async ({ canvas }) => {\n    await expect(canvas.getByTestId('value')).toBeInTheDocument();\n  },\n};\n"
