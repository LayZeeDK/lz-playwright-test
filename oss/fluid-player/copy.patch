+import { defineConfig, devices } from '@playwright/test';
+import base from './playwright.config';
+
+// Chromium instead of upstream's Firefox only, and the webpack dev server the specs expect on port 8080. The
+// config emits the e2e pages only in development mode, so `dev-server-test` (production mode) serves none.
+export default defineConfig({
+  ...base,
+  retries: 0,
+  reporter: [['list']],
+  // Specs that play local media, plus skip_stuck (streams .mkv from cdn.fluidplayer.com, stable so far). The
+  // others stream an H.264 MP4 from media.w3.org or fluidplayer.com, or play local H.264 and HLS ads; under
+  // Stryker's load they time out at random, and their results depend on the network.
+  testMatch: [
+    'ads_error_code.spec.ts',
+    'ads_error_url.spec.ts',
+    'ads_linear_user_tracking.spec.ts',
+    'ads_nonlinear.spec.ts',
+    'ads_pod.spec.ts',
+    'ads_vpaid_lifecycle.spec.ts',
+    'miniplayer.spec.ts',
+    'skip_stuck.spec.ts',
+    'subtitles.spec.ts',
+    'timeline_preview.spec.ts',
+    'vr.spec.ts',
+  ],
+  projects: [{ name: 'chromium', use: { ...devices['Desktop Chrome'] } }],
+  webServer: {
+    command: 'npx webpack serve --mode=development --no-live-reload --port 8080',
+    url: 'http://localhost:8080/controls.html',
+    reuseExistingServer: true,
+    timeout: 180_000,
+  },
+});
