+import base from './playwright-stories.config';
+
+// Vite through node, since cmd.exe cannot run `./node_modules/.bin/vite` and bun's .exe shims are invisible to npx,
+// and one shared gallery server for all Stryker test runner processes.
+export default {
+  ...base,
+  retries: 0,
+  reporter: [['list']],
+  webServer: {
+    command:
+      'node node_modules/vite/bin/vite.js --config playwright/vite.config.ts --host 127.0.0.1 --port 3161 --strictPort',
+    url: 'http://127.0.0.1:3161/playwright/gallery/index.html',
+    reuseExistingServer: true,
+  },
+};
