{
  "name": "@layzee/demo-app",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "@layzee/stryker-playwright-runner": "*"
  },
  "nx": {
    "tags": [
      "type:app"
    ],
    "targets": {
      "mutate-ct": {
        "command": "stryker run stryker.ct.config.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
